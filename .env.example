# ==============================================================================
# Automated Image Model Benchmarking for Edge Deployment - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file or sensitive database credentials to source control.
# ==============================================================================

# MySQL Database Configuration
# Explicit credentials are required. The system will NOT connect as root with an empty password.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=edge_model_benchmark
MYSQL_TEST_DATABASE=edge_model_benchmark_test
MYSQL_USER=your_benchmark_user
MYSQL_PASSWORD=your_secure_password_here

# Optional Connection URL Override
# If provided, DATABASE_URL takes precedence over individual MYSQL_* variables.
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>?charset=utf8mb4
# DATABASE_URL=mysql+pymysql://your_benchmark_user:your_secure_password_here@127.0.0.1:3306/edge_model_benchmark?charset=utf8mb4

# SQLAlchemy Connection Pool Settings
DB_POOL_SIZE=5
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true

# ==============================================================================
# Optional Edge Impulse Configuration
# ==============================================================================
# When absent, the application starts normally and operates in local benchmarking mode.
# To enable Edge Impulse target profiling in later phases, provide your project API key
# from Edge Impulse Studio (Dashboard -> Keys -> API Key).
# Real keys MUST remain in your gitignored local .env file. Never commit real keys.
# EDGE_IMPULSE_API_KEY=your_edge_impulse_api_key_here
# Optional Project ID (if required by custom API workflows; project API keys are already project-scoped)
# EDGE_IMPULSE_PROJECT_ID=your_edge_impulse_project_id_here

